# Kontabiliteti Pro KS — shembull i variablave të mjedisit.
# Kopjojeni si .env dhe vendosni vlera reale. Mos e komitoni .env.

NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL. Në zhvillim, skripti lokal nis një server PostgreSQL të integruar.
DATABASE_URL=postgresql://kontabilisti:kontabilisti@127.0.0.1:54329/kontabiliteti_pro?schema=public
TEST_DATABASE_URL=postgresql://kontabilisti:kontabilisti@127.0.0.1:54329/kontabiliteti_test?schema=public

# Çelës 32-bajtësh në hex (64 karaktere) për enkriptimin e sekretit TOTP.
# Gjeneroni: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=

# Sesionet ruhen në bazë. Emri i cookie-t dhe jetëgjatësia në ditë.
SESSION_COOKIE_NAME=kp_session
SESSION_DAYS=14

# Ngarkimi i dokumenteve (bajtë).
MAX_UPLOAD_BYTES=15728640
STORAGE_DIR=server/storage

# Email. Nëse mungon SMTP, mesazhet ruhen në EmailOutbox dhe NUK shënohen si të dërguara.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kontabiliteti Pro <noreply@example.com>"

# Administratori i platformës krijohet vetëm nga seed-i kur këto janë të vendosura.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Të dhëna demonstruese vetëm jashtë produksionit.
SEED_DEMO=false
DEMO_PASSWORD=

# Ditët e provës së konfiguruara nga politika e platformës (jo pagesë e simuluar).
DEFAULT_TRIAL_DAYS=14

# Zona kohore e Kosovës. Nuk ka identifikues IANA Europe/Pristina; CET përdoret përmes Europe/Belgrade.
APP_TIMEZONE=Europe/Belgrade
