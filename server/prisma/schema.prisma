// Kontabiliteti Pro KS
// Kufijtë e qiramarrjes janë të dokumentuar te docs/TENANCY.md.
// Çdo tabelë me firmId i përket një zyre kontabiliteti.
// Çdo tabelë me companyId i përket një kompanie kliente brenda asaj zyre.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

enum CompanyAccessScope {
  ALL_COMPANIES
  ASSIGNED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum CompanyStatus {
  ACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

enum VatRegistrationStatus {
  REGISTERED
  NOT_REGISTERED
  EXEMPT
  UNKNOWN
}

enum EngagementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  CANCELLED
  SUSPENDED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum BillingInvoiceStatus {
  ISSUED
  PAID
  VOID
  PAYMENT_FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  IN_REVIEW
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  BANK
  CASH
  OTHER
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  WAITING_DOCUMENTS
  IN_REVIEW
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentStatus {
  RECEIVED
  IN_REVIEW
  NEEDS_CLARIFICATION
  APPROVED
  REJECTED
  PROCESSED
  REVIEWED
}

enum MonthItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  NOT_APPLICABLE
}

enum DocumentRequestStatus {
  OPEN
  RECEIVED
  CANCELLED
}

enum TaxTreatmentKind {
  STANDARD
  REDUCED
  ZERO
  EXEMPT
  OUT_OF_SCOPE
}

enum TaxReportStatus {
  INTERNAL_DRAFT
  REVIEWED_BY_ACCOUNTANT
  MARKED_EXTERNALLY_SUBMITTED
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum ReconciliationStatus {
  OPEN
  COMPLETED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  POSTED
  PAID
}

enum TaxBaseMethod {
  GROSS
  GROSS_MINUS_EMPLOYEE_PENSION
}

enum DepreciationMethod {
  STRAIGHT_LINE
}

enum AssetStatus {
  ACTIVE
  DISPOSED
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  FAILED
  CANCELLED
}

enum EmailStatus {
  NOT_CONFIGURED
  SENT
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum FiscalEnvironment {
  TEST
  PRODUCTION
}

enum FiscalCouponType {
  SALE
  CANCEL
  RETURN
}

enum FiscalReceiptStatus {
  DRAFT
  READY
  PROCESSING
  FISCALIZED
  REJECTED
  UNKNOWN
  NOT_SENT
  CANCELLED
}

enum FiscalPaymentKind {
  CASH
  CREDIT_CARD
  VOUCHER
  CHEQUE
  CRYPTO
  OTHER
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum SupportGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum OcrStatus {
  UNVERIFIED
  REVIEWED
  REJECTED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String
  name                String
  status              UserStatus @default(ACTIVE)
  isPlatformAdmin     Boolean    @default(false)
  emailVerifiedAt     DateTime?
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  locale              String     @default("sq")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sessions             Session[]
  verificationTokens   VerificationToken[]
  memberships          FirmMembership[]
  companyMemberships   CompanyMembership[]
  invitationsSent      Invitation[]             @relation("InvitationSender")
  assignments          CompanyAssignment[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  supportRequests      SupportRequest[]
  grantsReceived       SupportAccessGrant[]     @relation("GrantRecipient")
  grantsGiven          SupportAccessGrant[]     @relation("GrantGiver")
  savedFilters         SavedFilter[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AccountingFirm {
  id             String     @id @default(uuid()) @db.Uuid
  legalName      String
  tradeName      String?
  businessNumber String?
  fiscalNumber   String?
  vatNumber      String?
  address        String?
  municipality   String?
  email          String
  phone          String?
  status         FirmStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  settings       FirmSettings?
  memberships    FirmMembership[]
  companies      ClientCompany[]
  invitations    Invitation[]
  subscription   Subscription?
  billingInvoices BillingInvoice[]
  subscriptionEvents SubscriptionEvent[]
  usageRecords   UsageRecord[]
  roles          Role[]
  auditLogs      AuditLog[]
  tasks          Task[]
  notifications  Notification[]
  documents      Document[]
  supportRequests SupportRequest[]
  supportGrants  SupportAccessGrant[]
  jobs           BackgroundJob[]
}

model FirmSettings {
  firmId                 String    @id @db.Uuid
  timezone               String    @default("Europe/Belgrade")
  locale                 String    @default("sq")
  onboardingCompletedAt  DateTime?
  notifyEmail            Boolean   @default(true)
  reminderDaysBefore     Int       @default(3)
  firm                   AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model Role {
  id          String             @id @default(uuid()) @db.Uuid
  firmId      String?            @db.Uuid
  scopeKey    String
  key         String
  name        String
  description String?
  isSystem    Boolean            @default(false)
  accessScope CompanyAccessScope @default(ASSIGNED)
  firm        AccountingFirm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships FirmMembership[]

  @@unique([scopeKey, key])
  @@index([firmId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model FirmMembership {
  id        String           @id @default(uuid()) @db.Uuid
  firmId    String           @db.Uuid
  userId    String           @db.Uuid
  roleId    String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  firm        AccountingFirm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user        User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  overrides   MembershipPermissionOverride[]
  assignments CompanyAssignment[]

  @@unique([firmId, userId])
  @@index([userId])
}

model MembershipPermissionOverride {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @db.Uuid
  permissionKey String
  effect       PermissionEffect
  membership   FirmMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, permissionKey])
}

model ClientCompany {
  id                   String                 @id @default(uuid()) @db.Uuid
  firmId               String                 @db.Uuid
  legalName            String
  tradeName            String?
  businessNumber       String?
  fiscalNumber         String?
  vatNumber            String?
  address              String?
  municipality         String?
  contactName          String?
  email                String?
  phone                String?
  activity             String?
  vatStatus            VatRegistrationStatus  @default(UNKNOWN)
  accountingStartDate  DateTime?              @db.Date
  fiscalYearStartMonth Int                    @default(1)
  status               CompanyStatus          @default(PENDING)
  servicePackage       String?
  engagementStatus     EngagementStatus       @default(DRAFT)
  notes                String?
  onboardingStep       Int                    @default(1)
  onboardingCompletedAt DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  firm          AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Restrict)
  settings      CompanySettings?
  assignments   CompanyAssignment[]
  memberships   CompanyMembership[]
  engagements   AccountingEngagement[]
  accounts      Account[]
  periods       FiscalPeriod[]
  customers     Customer[]
  suppliers     Supplier[]
  invoices      Invoice[]
  creditNotes   CreditNote[]
  purchases     PurchaseInvoice[]
  payments      Payment[]
  journals      JournalEntry[]
  bankAccounts  BankAccount[]
  taxRates      TaxRate[]
  taxReports    TaxReport[]
  expenseCategories ExpenseCategory[]
  employees     Employee[]
  payrollRuns   PayrollRun[]
  payrollRules  PayrollRuleSet[]
  assets        FixedAsset[]
  products      Product[]
  warehouses    Warehouse[]
  tasks         Task[]
  documents     Document[]
  documentRequests DocumentRequest[]
  sequences     DocumentSequence[]
  imports       ImportBatch[]
  exchangeRates ExchangeRate[]
  publishedReports PublishedReport[]
  requirements  OnboardingDocumentRequirement[]
  auditLogs     AuditLog[]
  monthChecklists MonthChecklist[]
  fiscalSettings FiscalSettings?
  fiscalReceipts FiscalReceipt[]

  @@index([firmId, status])
  @@index([firmId, legalName])
}

model CompanySettings {
  companyId                String  @id @db.Uuid
  firmId                   String  @db.Uuid
  invoiceSeries            String  @default("FAT")
  creditSeries             String  @default("NK")
  purchaseSeries           String  @default("BL")
  paymentTermsDays         Int     @default(15)
  invoiceFooter            String?
  paymentInstructions      String?
  baseCurrency             String  @default("EUR")
  timezone                 String  @default("Europe/Belgrade")
  mappings                 Json
  allowUnconfirmedTaxRates Boolean @default(false)
  company                  ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([firmId])
}

model CompanyAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  membershipId String         @db.Uuid
  companyId    String         @db.Uuid
  userId       String         @db.Uuid
  firmId       String         @db.Uuid
  createdAt    DateTime       @default(now())
  membership   FirmMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company      ClientCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([membershipId, companyId])
  @@index([userId, firmId])
  @@index([companyId])
}

model CompanyMembership {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  firmId    String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  canUpload Boolean          @default(true)
  canViewSharedReports Boolean @default(true)
  createdAt DateTime         @default(now())
  company   ClientCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([firmId])
}

model AccountingEngagement {
  id             String           @id @default(uuid()) @db.Uuid
  firmId         String           @db.Uuid
  companyId      String           @db.Uuid
  servicePackage String
  status         EngagementStatus @default(DRAFT)
  startDate      DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        ClientCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([firmId, companyId])
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  firmId     String    @db.Uuid
  companyId  String?   @db.Uuid
  email      String
  roleKey    String
  kind       String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdById String   @db.Uuid
  createdAt  DateTime  @default(now())
  firm       AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("InvitationSender", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([firmId, email])
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  description   String
  monthlyPrice  Decimal? @db.Decimal(19, 2)
  annualPrice   Decimal? @db.Decimal(19, 2)
  currency      String   @default("EUR")
  maxCompanies  Int?
  maxMembers    Int?
  isPublic      Boolean  @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
}

model PlanEntitlement {
  id         String           @id @default(uuid()) @db.Uuid
  planId     String           @db.Uuid
  featureKey String
  enabled    Boolean          @default(true)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  firmId             String             @unique @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  interval           BillingInterval    @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  readOnly           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  firm               AccountingFirm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  events             SubscriptionEvent[]
  billingInvoices    BillingInvoice[]
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  firmId         String   @db.Uuid
  subscriptionId String   @db.Uuid
  type           String
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now())
  firm           AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

model BillingInvoice {
  id             String               @id @default(uuid()) @db.Uuid
  firmId         String               @db.Uuid
  subscriptionId String               @db.Uuid
  number         String
  amount         Decimal              @db.Decimal(19, 2)
  currency       String               @default("EUR")
  status         BillingInvoiceStatus @default(ISSUED)
  description    String
  issuedAt       DateTime             @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  firm           AccountingFirm       @relation(fields: [firmId], references: [id], onDelete: Restrict)
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments       BillingPayment[]

  @@unique([firmId, number])
  @@index([firmId, status])
}

model BillingPayment {
  id               String         @id @default(uuid()) @db.Uuid
  billingInvoiceId String         @db.Uuid
  amount           Decimal        @db.Decimal(19, 2)
  receivedAt       DateTime
  method           String         @default("MANUAL")
  reference        String
  note             String
  recordedById     String         @db.Uuid
  createdAt        DateTime       @default(now())
  billingInvoice   BillingInvoice @relation(fields: [billingInvoiceId], references: [id], onDelete: Restrict)
}

model UsageRecord {
  id         String   @id @default(uuid()) @db.Uuid
  firmId     String   @db.Uuid
  metric     String
  value      Int
  recordedAt DateTime @default(now())
  firm       AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, metric, recordedAt])
}

model Municipality {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
}

model FiscalPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  firmId     String       @db.Uuid
  companyId  String       @db.Uuid
  name       String
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?      @db.Uuid
  company    ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, startDate, endDate])
  @@index([firmId, companyId, status])
}

model Account {
  id          String        @id @default(uuid()) @db.Uuid
  firmId      String        @db.Uuid
  companyId   String        @db.Uuid
  code        String
  name        String
  type        AccountType
  normalBalance NormalBalance
  parentId    String?       @db.Uuid
  isActive    Boolean       @default(true)
  isSystem    Boolean       @default(false)
  description String?
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent      Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]     @relation("AccountTree")
  lines       JournalEntryLine[]

  @@unique([companyId, code])
  @@index([firmId, companyId])
}

model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  firmId       String        @db.Uuid
  companyId    String        @db.Uuid
  entryNumber  Int?
  date         DateTime      @db.Date
  description  String
  status       JournalStatus @default(DRAFT)
  sourceType   String
  sourceId     String?
  periodId     String?       @db.Uuid
  reversalOfId String?       @unique @db.Uuid
  postedAt     DateTime?
  postedById   String?       @db.Uuid
  createdById  String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reversalOf   JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("Reversal")
  lines        JournalEntryLine[]
  invoice      Invoice?
  purchase     PurchaseInvoice?
  payment      Payment?      @relation("PaymentJournal")
  paymentReversal Payment?   @relation("PaymentReversalJournal")
  creditNote   CreditNote?
  payrollRun   PayrollRun?
  depreciation DepreciationEntry?

  @@unique([companyId, entryNumber])
  @@index([firmId, companyId, date])
  @@index([companyId, status])
}

model JournalEntryLine {
  id        String       @id @default(uuid()) @db.Uuid
  entryId   String       @db.Uuid
  firmId    String       @db.Uuid
  companyId String       @db.Uuid
  accountId String       @db.Uuid
  description String?
  debit     Decimal      @default(0) @db.Decimal(19, 2)
  credit    Decimal      @default(0) @db.Decimal(19, 2)
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([companyId, accountId])
  @@index([firmId])
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  companyId    String   @db.Uuid
  name         String
  fiscalNumber String?
  vatNumber    String?
  address      String?
  municipality String?
  email        String?
  phone        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  payments     Payment[]

  @@index([firmId, companyId, name])
}

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  companyId    String   @db.Uuid
  name         String
  fiscalNumber String?
  vatNumber    String?
  address      String?
  municipality String?
  email        String?
  phone        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchases    PurchaseInvoice[]
  payments     Payment[]

  @@index([firmId, companyId, name])
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  firmId               String        @db.Uuid
  companyId            String        @db.Uuid
  customerId           String?       @db.Uuid
  series               String        @default("FAT")
  number               Int?
  displayNumber        String?
  status               InvoiceStatus @default(DRAFT)
  issueDate            DateTime      @db.Date
  dueDate              DateTime      @db.Date
  currency             String        @default("EUR")
  exchangeRate         Decimal       @default(1) @db.Decimal(19, 8)
  notes                String?
  paymentTerms         String?
  paymentInstructions  String?
  subtotal             Decimal       @default(0) @db.Decimal(19, 2)
  discountTotal        Decimal       @default(0) @db.Decimal(19, 2)
  taxableBase          Decimal       @default(0) @db.Decimal(19, 2)
  vatTotal             Decimal       @default(0) @db.Decimal(19, 2)
  total                Decimal       @default(0) @db.Decimal(19, 2)
  amountPaid           Decimal       @default(0) @db.Decimal(19, 2)
  amountCredited       Decimal       @default(0) @db.Decimal(19, 2)
  journalEntryId       String?       @unique @db.Uuid
  finalizedAt          DateTime?
  finalizedById        String?       @db.Uuid
  createdById          String        @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  company              ClientCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journalEntry         JournalEntry? @relation(fields: [journalEntryId], references: [id])
  lines                InvoiceLine[]
  allocations          PaymentAllocation[]
  creditNotes          CreditNote[]
  fiscalReceipts       FiscalReceipt[]

  @@unique([companyId, series, number])
  @@unique([companyId, displayNumber])
  @@index([firmId, companyId, status])
  @@index([companyId, issueDate])
}

model InvoiceLine {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @db.Uuid
  firmId          String   @db.Uuid
  companyId       String   @db.Uuid
  position        Int
  description     String
  quantity        Decimal  @db.Decimal(19, 4)
  unitPrice       Decimal  @db.Decimal(19, 4)
  discountPercent Decimal  @default(0) @db.Decimal(7, 4)
