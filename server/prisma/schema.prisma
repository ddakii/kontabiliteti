  action        String
  entityType    String?
  entityId      String?
  summary       String
  metadata      Json?
  sensitive     Boolean  @default(false)
  ip            String?
  correlationId String?
  createdAt     DateTime @default(now())
  firm          AccountingFirm? @relation(fields: [firmId], references: [id], onDelete: SetNull)
  company       ClientCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
  @@index([companyId, createdAt])
  @@index([action])
}

model ImportBatch {
  id          String       @id @default(uuid()) @db.Uuid
  firmId      String       @db.Uuid
  companyId   String       @db.Uuid
  type        String
  status      ImportStatus @default(PREVIEW)
  fileName    String
  summary     Json
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  committedAt DateTime?
  company     ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([firmId, companyId])
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  firmId        String   @db.Uuid
  companyId     String   @db.Uuid
  baseCurrency  String   @default("EUR")
  quoteCurrency String
  rate          Decimal  @db.Decimal(19, 8)
  effectiveOn   DateTime @db.Date
  source        String   @default("MANUAL")
  createdById   String   @db.Uuid
  company       ClientCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, baseCurrency, quoteCurrency, effectiveOn])
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @db.Uuid
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([firmId, key])
}

model EmailOutbox {
  id        String      @id @default(uuid()) @db.Uuid
  firmId    String?     @db.Uuid
  toAddress String
  subject   String
  body      String
  status    EmailStatus
  error     String?
  relatedType String?
  relatedId String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?
}

model OcrExtraction {
  id                String           @id @default(uuid()) @db.Uuid
  documentId        String?          @db.Uuid
  purchaseInvoiceId String?          @db.Uuid
  status            OcrStatus        @default(UNVERIFIED)
  provider          String
  payload           Json
  createdAt         DateTime         @default(now())
  document          Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  purchase          PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SupportRequest {
  id        String        @id @default(uuid()) @db.Uuid
  firmId    String        @db.Uuid
  userId    String        @db.Uuid
  subject   String
  body      String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  firm      AccountingFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SupportAccessGrant {
  id              String             @id @default(uuid()) @db.Uuid
  firmId          String             @db.Uuid
  companyId       String?            @db.Uuid
  grantedToUserId String             @db.Uuid
  grantedByUserId String             @db.Uuid
  reason          String
  expiresAt       DateTime
  revokedAt       DateTime?
  status          SupportGrantStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  firm            AccountingFirm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  grantedTo       User               @relation("GrantRecipient", fields: [grantedToUserId], references: [id])
  grantedBy       User               @relation("GrantGiver", fields: [grantedByUserId], references: [id])

  @@index([firmId, status])
}

model BackgroundJob {
  id         String    @id @default(uuid()) @db.Uuid
  firmId     String?   @db.Uuid
  type       String
  status     JobStatus @default(PENDING)
  payload    Json
  lastError  String?
  runAt      DateTime
  startedAt  DateTime?
  finishedAt DateTime?
  attempts   Int       @default(0)
  dedupeKey  String?   @unique
  createdAt  DateTime  @default(now())
  firm       AccountingFirm? @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model SavedFilter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  firmId    String   @db.Uuid
  companyId String?  @db.Uuid
  resource  String
  name      String
  query     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, firmId, resource])
}

model FiscalSettings {
  id                  String            @id @default(uuid()) @db.Uuid
  firmId              String            @db.Uuid
  companyId           String            @unique @db.Uuid
  environment         FiscalEnvironment @default(TEST)
  nui                 String?
  fiscalizationNoEnc  String?
  applicationId       String?
  businessName        String?
  defaultUnit         String?
  itemType            String?
  nextCouponId        Int               @default(1)
  connectionCheckedAt DateTime?
  connectionOk        Boolean           @default(false)
  connectionNote      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             ClientCompany     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branches            FiscalBranch[]
  receipts            FiscalReceipt[]

  @@index([firmId, companyId])
}

model FiscalBranch {
  id           String         @id @default(uuid()) @db.Uuid
  firmId       String         @db.Uuid
  companyId    String         @db.Uuid
  settingsId   String         @db.Uuid
  branchNumber String
  location     String
  createdAt    DateTime       @default(now())
  settings     FiscalSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  terminals    FiscalPos[]

  @@unique([settingsId, branchNumber])
  @@index([firmId, companyId])
}

model FiscalPos {
  id                  String       @id @default(uuid()) @db.Uuid
  firmId              String       @db.Uuid
  companyId           String       @db.Uuid
  branchId            String       @db.Uuid
  posNumber           String
  keyFingerprint      String?
  certificatePem      String?      @db.Text
  certificateNotAfter DateTime?
  privateKeyPath      String?
  onboardedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  branch              FiscalBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  receipts            FiscalReceipt[]

  @@unique([branchId, posNumber])
  @@index([firmId, companyId])
}

model FiscalReceipt {
  id                String               @id @default(uuid()) @db.Uuid
  firmId            String               @db.Uuid
  companyId         String               @db.Uuid
  settingsId        String               @db.Uuid
  invoiceId         String?              @db.Uuid
  posId             String               @db.Uuid
  couponId          String
  type              FiscalCouponType
  environment       FiscalEnvironment
  status            FiscalReceiptStatus  @default(READY)
  verificationNo    String
  paymentKind       FiscalPaymentKind
  detailsBase64     String?              @db.Text
  signature         String?              @db.Text
  qrPayload         String?              @db.Text
  transactionId     String?
  atkMessage        String?
  errorMessage      String?
  attemptCount      Int                  @default(0)
  total             Decimal              @db.Decimal(19, 2)
  payloadSummary    Json
  originalReceiptId String?              @db.Uuid
  reason            String?
  createdById       String               @db.Uuid
  submittedAt       DateTime?
  responseAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           ClientCompany        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  settings          FiscalSettings       @relation(fields: [settingsId], references: [id], onDelete: Restrict)
  invoice           Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  pos               FiscalPos            @relation(fields: [posId], references: [id], onDelete: Restrict)
  originalReceipt   FiscalReceipt?       @relation("FiscalOriginal", fields: [originalReceiptId], references: [id], onDelete: Restrict)
  derivedReceipts   FiscalReceipt[]      @relation("FiscalOriginal")
  attempts          FiscalAttempt[]

  @@unique([companyId, couponId])
  @@unique([companyId, verificationNo])
  @@index([firmId, companyId, status])
  @@index([companyId, invoiceId])
}

model FiscalAttempt {
  id         String        @id @default(uuid()) @db.Uuid
  receiptId  String        @db.Uuid
  firmId     String        @db.Uuid
  companyId  String        @db.Uuid
  outcome    String
  httpStatus Int?
  message    String?
  createdAt  DateTime      @default(now())
  receipt    FiscalReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([companyId, receiptId])
}
